# Public (exposed to the browser only when prefixed with NEXT_PUBLIC_)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# OpenRouter — used only by scripts/generate-site-images.mjs (locally). In CI, use the
# repository secret OPENROUTER_API_KEY (see .github/workflows/generate-site-images.yml).
# OPENROUTER_API_KEY=sk-or-v1-...
# Optional override (default is best-quality): OPENROUTER_IMAGE_MODEL=openai/gpt-5-image

# Optional: Google Business Profile URLs for reviews CTAs (match your live GBP)
# NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=https://g.page/r/your-profile
# NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://search.google.com/local/writereview?placeid=ChIJ...

# Google Maps Platform — amenity map (Maps JavaScript API + Places API (New) nearby search)
# Enable Maps JavaScript API and Places API (New) on the same Google Cloud project.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-restricted-key
# Optional Advanced Markers map style:
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id

# Server-only: optional webhook URL for contact form JSON POST (name, email, phone, message, propertyInterest, preferredContact, site, submittedAt)
# CONTACT_WEBHOOK_URL=https://example.com/api/contact-hook

# Cloudflare cache purge helper script (scripts/cloudflare-cache-purge.mjs)
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Optional zone resolution overrides:
# CLOUDFLARE_ZONE_ID=your-zone-id
# CLOUDFLARE_ZONE_NAME=pewtervalleyestates.com
# Optional purge controls:
# CLOUDFLARE_PURGE_MODE=everything
# CLOUDFLARE_PURGE_URLS=https://www.pewtervalleyestates.com/,https://www.pewtervalleyestates.com/contact
# CLOUDFLARE_PURGE_DRY_RUN=false
